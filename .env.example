# Claude API — when set, inquiries are scored by the model. When unset, the app
# falls back to a transparent heuristic scorer so demos run with zero secrets.
ANTHROPIC_API_KEY=

# Supabase — when both are set, leads/firms persist to Postgres. When unset, the
# app uses an in-memory store (resets on restart) — fine for demos and audits.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
